{
  "name": "derp",
  "version": "2.1.0",
  "description": "An Ethereum RPC provider which gives access to the logs it gathers.",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write 'server/*.{js,ts,json}' 'public/*.{css,json,md,html}' README.md '.github/**/*.yml'",
    "build": "react-scripts build",
    "dev": "wrangler dev --local-protocol https",
    "types:check": "tsc -p server",
    "start": "react-scripts start",
    "start-https": "HTTPS=true pnpm start",
    "lint": "eslint --ext .jsx .",
    "lint:fix": "eslint --fix --ext .jsx .",
    "test": "react-scripts test --watchAll=false --passWithNoTests",
    "test:local": "node test-derp-local.js",
    "test:e2e": "node test-derp-orchestrated.js",
    "eject": "react-scripts eject"
  },
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.9.0",
    "@emotion/styled": "^11.8.1",
    "@ethersproject/bytes": "^5.6.1",
    "@mui/icons-material": "^5.8.3",
    "@mui/material": "^5.8.3",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "ethers": "5.7.2",
    "leaflet": "^1.9.3",
    "leaflet-defaulticon-compatibility": "^0.1.1",
    "lottie-web": "^5.9.4",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-id-generator": "^3.0.2",
    "react-leaflet": "^4.2.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "wrangler": "^4.141.0",
    "ws": "^8.22.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
